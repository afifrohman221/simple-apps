pipeline {
    agent { label 'docker-ubuntu' }

    stages {
        stage('Pull SCM') {
            steps {
                git branch: 'main', url: 'https://github.com/afifrohman221/simple-apps.git'
            }
        }
        
        stage('Cleanup') {
            steps {
                sh'''
                docker compose down
                '''
            }
        }

        stage('Build') {
            steps {
                sh'''
                npm install
                '''
            }
        }
        
        stage('Testing') {
            steps {
                sh'''
                npm test
                '''
            }
        }
        
        stage('Code Review') {
            steps {
                sh'''
                sonar-scanner \
                    -Dsonar.projectKey=simple-apps \
                    -Dsonar.sources=. \
                    -Dsonar.host.url=http://172.23.1.132:9000 \
                    -Dsonar.login=sqp_4d3e7ed24170c704503bf3b9e2e3291dfcd3b477
                '''
            }
        }
        
        stage('Deploy') {
            steps {
                sh'''
                docker compose up --build -d
                '''
            }
        }
        
        stage('Backup') {
            steps {
                 sh 'docker compose push' 
            }
        }
    }
}